# Database Configuration
DB_DRIVER=postgres
DBUSER=postgres
DBPASS=postgres_password
DBHOST=localhost
DBPORT=5432
DBNAME=messages
DB_SSLMODE=disable

# Server Configuration
SERVER_PORT=8080

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Optional: Redis Configuration (for future use)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Optional: JWT Configuration (for future use)
# JWT_SECRET=your-secret-key-here
# JWT_EXPIRATION=24h
